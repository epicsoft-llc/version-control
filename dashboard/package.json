{
  "name": "vc-dashboard",
  "version": "0.10.3",
  "description": "Version Control dashboard",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=development",
    "build": "ng build",
    "build:dev": "ng build --configuration=development",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test",
    "i18n:verify": "node scripts/i18n-verify.mjs",
    "dep:update": "npm-check-updates --errorLevel 2 -x typescript -x zone.js"
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/localize": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "@fontsource-variable/inter": "5.3.0",
    "@ng-bootstrap/ng-bootstrap": "21.0.0",
    "@ngx-translate/core": "18.1.0",
    "@ngx-translate/http-loader": "18.1.0",
    "bootstrap": "5.3.9",
    "bootstrap-icons": "1.13.2",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "jsdom": "31.0.0",
    "npm-check-updates": "23.1.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@": true,
    "esbuild@": true,
    "lmdb@": true,
    "msgpackr-extract@": true
  }
}
