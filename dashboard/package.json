{
  "name": "vc-dashboard",
  "version": "0.2.1",
  "description": "Version Control dashboard",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=development",
    "build": "ng build",
    "build:dev": "ng build --configuration=development",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test",
    "i18n:pull": "node scripts/i18n-pull.mjs",
    "i18n:verify": "node scripts/i18n-verify.mjs",
    "dep:update": "npm-check-updates --errorLevel 2"
  },
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/localize": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "@ng-bootstrap/ng-bootstrap": "21.0.0",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "jsdom": "30.0.1",
    "npm-check-updates": "23.0.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
