# Copy to .env and fill in. The .env file is never committed.
#
# Nothing here has a working default on purpose: a value that is missing must
# fail or disable its feature, never quietly do something half right.

#### Database — required
VC_DATABASE_NAME=versioncontrol
VC_DATABASE_USERNAME=
VC_DATABASE_PASSWORD=

#### Port the dashboard is published on
VC_HTTP_PORT=8081

#### Where the images come from: the GitLab registry (default) or Docker Hub,
#### epicsoft/version-control, which carries releases only
VC_IMAGE_REPOSITORY=registry.gitlab.com/epicsoft-networks/version-control

#### Which images to run: a release such as 0.1.0 or latest, or a branch build,
#### main (default) or develop
VC_IMAGE_TAG=main

#### GitHub — optional.
#### Without a token the update check keeps working at the lower rate limit
#### (60 requests/hour instead of 5.000).
VC_GITHUB_TOKEN=

#### Telegram — optional.
#### Without a token nothing goes to Telegram; the application logs that once
#### and carries on.
VC_TELEGRAM_BOT_TOKEN=
VC_TELEGRAM_CHAT_ID=

#### Mail — optional, any SMTP server.
#### Without host, sender and recipient no mail is sent.
#### Security: starttls (port 587), tls (465) or none (25, login in clear text).
#### Set the port only when it differs from that.
VC_MAIL_HOST=
VC_MAIL_PORT=
VC_MAIL_SECURITY=starttls
#### Without a username no login is attempted.
VC_MAIL_USERNAME=
VC_MAIL_PASSWORD=
#### Sender, optionally with a name: Version Control <vc@example.com>
VC_MAIL_FROM=
#### One or more recipients, comma separated.
VC_MAIL_TO=

#### How Debian package versions are written on the pages and in the daily
#### summary: short (29.9.2-1) or full (5:29.9.2-1~ubuntu.24.04~noble).
#### Only the display; what is stored, compared and copied stays complete.
VC_DISPLAY_DEBIAN_VERSIONS=short

#### Known vulnerabilities — optional, see docs/vulnerabilities.md.
VC_VULNERABILITIES_DB_URL=
VC_VULNERABILITIES_DB_USERNAME=
VC_VULNERABILITIES_DB_PASSWORD=
VC_VULNERABILITIES_DB_DRIVER=
